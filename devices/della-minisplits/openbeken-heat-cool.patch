+static void TCL_PublishFanDiscovery(void) {
+	char json[400];
+	char channel[MQTT_PUBLISH_ITEM_CHANNEL_LENGTH];
+	const char *dev = CFG_GetDeviceName();
+	int len;
+
+	len = snprintf(json, sizeof(json),
+		"{\"dev\":{\"ids\":[\"%s\"]},\"name\":\"Fan\",\"~\":\"%s\","
+		"\"stat_t\":\"~/FanRunning/get\",\"avty_t\":\"~/connected\","
+		"\"uniq_id\":\"%s_fan_running\",\"dev_cla\":\"running\","
+		"\"pl_on\":\"1\",\"pl_off\":\"0\"}",
+		dev, CFG_GetMQTTClientId(), dev);
+	if (len <= 0 || len >= (int)sizeof(json))
+		return;
+	len = snprintf(channel, sizeof(channel), "binary_sensor/%s_fan_running/config", dev);
+	if (len <= 0 || len >= (int)sizeof(channel))
+		return;
+	MQTT_QueuePublish(tcl_discovery_topic, channel, json, OBK_PUBLISH_FLAG_RETAIN);
 }
 

+// HVAC action from the unit's real operating state rather than the commanded
+// mode: in heat_cool the hardware sits in heat or cool permanently and its own
+// thermostat cycles the compressor, so the mode alone says nothing about
+// whether it is actually heating or cooling right now. Direction comes from
+// the reversing valve, not the mode, because heat_cool may switch the mode
+// while the outdoor unit is still winding down from the previous direction.
+static const char *TCL_ComputeAction(void) {
+	if (!tcl_hw_power)
+		return "off";
+	if (tcl_outdoor_flags & TCL_OUTDOOR_FLAG_RUNNING) {
+		if (tcl_hw_mode == 0x03)
+			return "drying";
+		if (tcl_outdoor_flags & TCL_OUTDOOR_FLAG_HEAT)
+			return "heating";
+		// Heat mode with the valve in the cooling position: defrost cycle.
+		if (tcl_hw_mode == 0x04)
+			return "defrosting";
+		return "cooling";
+	}
+	if (tcl_indoor_fan)
+		return "fan";
+	return "idle";
+}
